// Vibex data model. Project count drives routing (0 → /new, ≥1 → dashboard).
// Auth.js adapter models + product models (Project / Run / Prompt / UsageWindow / ApiKey).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection
  directUrl = env("DIRECT_URL") // Neon direct connection (migrations)
}

// ── Auth.js (NextAuth) adapter models ──────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  plan          String    @default("free") // free | starter | pro | scale
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  projects     Project[]
  apiKeys      ApiKey[]
  usageWindows UsageWindow[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Product models ─────────────────────────────────────────
enum RunStatus {
  RUNNING
  PAUSED
  COMPLETED
  INTERRUPTED
  FAILED
}

enum PromptRole {
  CODER
  REVIEWER
}

enum WindowKind {
  FIVE_HOUR
  DAILY
  MONTHLY
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  title     String
  spec      Json // the locked goal: idea, platform, models, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs Run[]

  @@index([userId])
}

model Run {
  id          String    @id @default(cuid())
  projectId   String
  status      RunStatus @default(RUNNING)
  currentStep Int       @default(0)
  totalSteps  Int       @default(0)
  files       Json? // generated code: [{ path, content }]
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompts Prompt[]

  @@index([projectId])
}

model Prompt {
  id        String     @id @default(cuid())
  runId     String
  step      Int
  role      PromptRole
  model     String
  content   String     @db.Text
  tokens    Int        @default(0)
  cost      Float      @default(0)
  createdAt DateTime   @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model UsageWindow {
  id        String     @id @default(cuid())
  userId    String
  kind      WindowKind
  tokens    Int        @default(0)
  cost      Float      @default(0)
  startedAt DateTime   @default(now())
  resetsAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

// Fixed-window rate limiter. One row per (route + subject); `count` resets when `resetsAt`
// passes. A small over-count under a burst is fine — this is an abuse guard, not billing.
model RateLimit {
  key      String   @id // `${route}:${subject}` (subject = userId or IP)
  count    Int      @default(0)
  resetsAt DateTime
}

// Design RAG: curated references the art-director critic retrieves from to judge generated UIs.
// Embeddings are stored as a plain Float[] and cosine similarity is computed in JS — the corpus
// is tiny (~dozens of rows), so this avoids the pgvector extension entirely (safer on the shared
// Neon DB). Empty `embedding` is fine: retrieval then falls back to category match.
model DesignReference {
  id        String   @id @default(cuid())
  category  String // landing | dashboard | tool | form | general
  title     String
  body      String   @db.Text
  embedding Float[]
  createdAt DateTime @default(now())

  @@index([category])
}

// BYOK keys — encrypted at rest (AES-256-GCM), one per provider per user.
model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  provider   String // "anthropic" | "openai" | "google"
  ciphertext String   @db.Text
  iv         String
  authTag    String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}
