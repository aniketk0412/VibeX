# ── Database (Neon serverless Postgres) ───────────────────────────
# Create a project at https://neon.tech and paste the connection strings.
# DATABASE_URL = pooled (-pooler host); DIRECT_URL = direct (for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth.js (NextAuth) ────────────────────────────────────────────
# Generate a secret: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-me"
# Google OAuth — https://console.cloud.google.com (Authorized redirect:
#   http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email magic links via Resend — https://resend.com/api-keys
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Vibex <onboarding@resend.dev>"

# ── BYOK encryption ───────────────────────────────────────────────
# 32-byte key for encrypting stored API keys. Generate: `openssl rand -hex 32`
ENCRYPTION_KEY=""

# ── AI providers (Vibex-managed plans) ────────────────────────────
# Used only by the Vibex-plan tiers. BYOK users supply their own keys at runtime.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
