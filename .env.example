# ── Database (Neon serverless Postgres) ───────────────────────────
# Create a project at https://neon.tech and paste the connection strings.
# DATABASE_URL = pooled (-pooler host); DIRECT_URL = direct (for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth.js (NextAuth) ────────────────────────────────────────────
# Generate a secret: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-me"
# Google OAuth — https://console.cloud.google.com (Authorized redirect:
#   http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email magic links via Resend — https://resend.com/api-keys
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Vibex <onboarding@resend.dev>"

# ── BYOK encryption ───────────────────────────────────────────────
# 32-byte key for encrypting stored API keys. Generate: `openssl rand -hex 32`
ENCRYPTION_KEY=""

# ── AI providers ──────────────────────────────────────────────────
# Set any of these to run real models; leave all blank and the engine simulates.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# OpenRouter — if set, the engine routes ALL calls here (great for free models, $0).
# Free model ids end in ":free" (e.g. openai/gpt-oss-20b:free). https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-20b:free"

# ── Billing (LemonSqueezy) — optional; checkout/webhook are inert until set ───────
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_VARIANT_STARTER=""
LEMONSQUEEZY_VARIANT_PRO=""
LEMONSQUEEZY_VARIANT_SCALE=""

# Dev-only: allow switching your own plan from /settings (never set true in prod).
ALLOW_DEV_PLAN=""

# ── Deploy tokens (optional) ──────────────────────────────────────
# One-click deploy prefers each user's OWN Vercel/Netlify BYOK token. These shared server tokens
# are used as a fallback ONLY when ALLOW_SHARED_DEPLOY="true" — otherwise every user's generated
# app would deploy under YOUR account (an abuse/ToS liability at scale). Leave unset in production.
ALLOW_SHARED_DEPLOY=""
VERCEL_DEPLOY_TOKEN=""
NETLIFY_DEPLOY_TOKEN=""

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
